# Ring Developer Playground token (≈30 min). Paste your own; never commit .env
RING_ACCESS_TOKEN=
# Optional: the Ring device the live run watches (default: the first device on the account)
RING_DEVICE_ID=
# HMAC key for Ring webhooks (your app's key; any string for the local simulator)
RING_HMAC_KEY=
# Optional: phone notifications for the demo
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional overrides
DOORLEDGER_WRITER_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
DOORLEDGER_VISION_MODEL=us.amazon.nova-2-lite-v1:0
# Agency-only: required to issue Caregiver Pass links
DOORLEDGER_ADMIN_TOKEN=
# Days to keep stored evidence frames (default 30)
DOORLEDGER_RETENTION_DAYS=30
# Demo SMS via Amazon SNS (number must be verified in the SNS sandbox), E.164 format
DOORLEDGER_SMS_TO=
# Demo voice call to the patient via Amazon Connect (all four required; E.164 numbers).
# Every call goes ONLY to DOORLEDGER_VOICE_TO (one verified test phone), never to household members.
DOORLEDGER_VOICE_TO=
DOORLEDGER_CONNECT_INSTANCE_ID=
DOORLEDGER_CONNECT_FLOW_ID=
DOORLEDGER_CONNECT_SOURCE_NUMBER=
# DOORLEDGER_CONNECT_REGION=us-east-1
# Optional: route /api/ask and /api/summary to the deployed Bedrock AgentCore runtime
DOORLEDGER_AGENTCORE_ARN=
DOORLEDGER_DYNAMO=
